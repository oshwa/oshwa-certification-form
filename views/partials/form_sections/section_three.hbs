
<section class="page-section" id="form-3">
  <div class="row align-justify">
    <div class="columns">
      <h2>Licensing Information</h2>
      <span class="section-header">Section 3 of 4</span>
        <p>This part of the form asks for information about your project’s licensing. In order to qualify for OSHWA certification, you must have chosen an open source license for your <a href="https://certification.oshwa.org/process/hardware.html" target="blank">hardware</a>, your <a href="https://certification.oshwa.org/process/software.html" target="blank">software</a> (if any), and your <a href="https://certification.oshwa.org/process/documentation.html" target="blank">documentation</a>. Your licenses for each of these elements will appear on your project’s profile listing.</p>
    </div>
  </div>

  <div class="row align-center">
    <div class="columns large-11 small-12">
      {{!-- 24 --}}
      <div class="row">
        <div class="columns large-6 medium-6 small-12">
          {{{ createLabel formValues=sectionThree.field.hardwareLicense }}}
        </div>
        <div class="columns large-6 medium-6 small-12">
          {{{ createDropdownSelect formValues=sectionThree.field.hardwareLicense options=hardwareLicenses selection=project.hardwareLicense }}}
        </div>
      </div>
      {{!-- hardware examples --}}
      {{> module_examples/hardware-examples}}


      {{!-- 25 --}}
      <div class="row">
        <div class="columns large-6 medium-6 small-12">
          {{{ createLabel formValues=sectionThree.field.softwareLicense }}}
        </div>
        <div class="columns large-6 medium-6 small-12">
          {{{ createDropdownSelect formValues=sectionThree.field.softwareLicense options=softwareLicenses selection=project.softwareLicense }}}
        </div>
      </div>
      {{!-- software examples --}}
      {{> module_examples/software-examples}}


      {{!-- 26 --}}
      <div class="row">
        <div class="columns large-6 medium-6 small-12">
          {{{createLabel formValues=sectionThree.field.documentationLicense}}}
        </div>
        <div class="columns large-6 medium-6 small-12">
          {{{createDropdownSelect formValues=sectionThree.field.documentationLicense options=documentationLicenses selection=project.documentationLicense}}}
        </div>
      </div>
      {{!-- documentation examples --}}
      {{> module_examples/documentation-examples}}

     {{!-- Licensing Checklist  --}}
     <div class="row align-center">
      <div class="columns large-11 small-12">
        <div class="row">
          <div class="columns licensing-checklist">
            
            {{{ createLicensingChecklist
                formValues=sectionThree.field.licensingChecklist
                checkedOptions=project.licensingChecklist}}}
          </div>
        </div>

        
        <div class="row">
          <div class="columns large-3 small-12 ">
            {{{createLabel formValues=sectionThree.field.licensingChecklistExplanation}}}
          </div>
          <div class="columns">
            {{{createTextArea formValues=sectionThree.field.licensingChecklistExplanation inputValue=project.licensingChecklistExplanation}}}
          </div>
        </div>

      </div>
     </div>

    </div>
  </div>
  <hr>
</section>
